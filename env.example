# Supabase Configuration (Required for Authentication)
# Get these from your Supabase project dashboard: Settings > API
# Starting November 2025, use new "Publishable" key instead of legacy "anon" key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Auth Configuration
# Deep link scheme for email verification and password reset
# Should match the scheme in app.config.ts (default: overtime-plus)
EXPO_PUBLIC_REDIRECT_SCHEME=overtime-plus

# Domain Restriction (Optional)
# Set to true to restrict signups to @health.qld.gov.au emails only
# Set to false to allow any email domain
EXPO_PUBLIC_AUTH_REQUIRE_DOMAIN=true

# App Configuration
EXPO_PUBLIC_APP_NAME=Overtime+
EXPO_PUBLIC_APP_VERSION=1.0.0

# Development Settings
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_LOG_LEVEL=info

# OTA Template System (Optional)
# Set to true to enable Over-The-Air template updates from Supabase storage
# Set to false to use bundled templates only
EXPO_PUBLIC_TEMPLATE_OTA=false

# RevenueCat Configuration
# Public API keys for RevenueCat. Use test keys for development builds.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=rc_ios_public_key_here
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=rc_android_public_key_here
EXPO_PUBLIC_REVENUECAT_API_KEY_AMAZON=rc_amazon_public_key_here

# Legal Links
# Required for App Store review; shown on paywall and in settings
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-domain.com/privacy
EXPO_PUBLIC_TERMS_URL=https://your-domain.com/terms
