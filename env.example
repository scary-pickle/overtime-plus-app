# Supabase Configuration (Required for Authentication)
# Get these from your Supabase project dashboard: Settings > API
# Starting November 2025, use new "Publishable" key instead of legacy "anon" key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Auth Configuration
# Deep link scheme for email verification and password reset
# Should match the scheme in app.config.ts (default: overtime-plus)
EXPO_PUBLIC_REDIRECT_SCHEME=overtime-plus

# Domain Restriction (Optional)
# Set to true to restrict signups to @health.qld.gov.au emails only
# Set to false to allow any email domain
EXPO_PUBLIC_AUTH_REQUIRE_DOMAIN=true

# App Configuration
EXPO_PUBLIC_APP_NAME=Overtime+
EXPO_PUBLIC_APP_VERSION=1.0.0

# Development Settings
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_LOG_LEVEL=info
